# Show clearly labelled sample content. Ignored on the Vercel production site.
SHOW_SAMPLES=true
# Public address of the live site, without a trailing slash.
SITE_URL=http://localhost:3000
# Set to true only after the launch checklist passes. Until then search engines are blocked.
SITE_LAUNCHED=false
# From Supabase. Both are safe for browsers. NEVER put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
